    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video image</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="es_ES">Reproduce vídeos, series y fotos de Google Drive con enlaces públicos</summary>
    <description lang="es_ES">Biblioteca propia de películas, series y fotos alojadas en Google Drive (compartidas con "Cualquier persona con el enlace"). No necesita iniciar sesión ni claves de API. Permite añadir enlaces sueltos o importar carpetas completas.</description>
    <disclaimer lang="es_ES">Usa solo contenido del que tengas derechos.</disclaimer>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
    <license>MIT</license>
  </extension>
</addon>
<addon id="plugin.video.megaplayer" name="MEGA Player" version="1.2.0" provider-name="local">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests"/>
    <import addon="script.module.pycryptodome"/>
    <import addon="plugin.video.elementum" version="0.0.1" optional="true"/>
    <import addon="plugin.video.torrest" version="0.0.1" optional="true"/>
    <import addon="inputstream.adaptive" version="0.0.1" optional="true"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video image audio</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <summary lang="es_ES">Reproduce películas, series, fotos y música de tu cuenta MEGA</summary>
    <description lang="es_ES">Navega tu nube MEGA, reproduce con streaming descifrado al vuelo, exporta a la biblioteca de Kodi (.strm) y reproduce torrents/magnets mediante Elementum o Torrest.</description>
    <license>MIT</license>
  </extension>
</addon>
<addon id="plugin.video.miaddon" name="mi addon" version="1.0.1" provider-name="miaddon">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <!-- Obligatorias (repositorio oficial de Kodi 19+) -->
    <import addon="script.module.requests"/>
    <import addon="script.module.beautifulsoup4"/>
    <import addon="script.module.inputstreamhelper"/>
    <import addon="plugin.video.youtube"/>
    <!-- Reproducción de streams: opcionales para que la instalación nunca falle;
         Kodi las instala solas si están en tus repositorios -->
    <import addon="inputstream.adaptive" optional="true"/>
    <import addon="inputstream.ffmpegdirect" optional="true"/>
    <import addon="inputstream.rtmp" optional="true"/>
    <import addon="pvr.iptvsimple" optional="true"/>
    <!-- Torrents (repos de terceros): Elementum o Torrest, cualquiera de los dos -->
    <import addon="plugin.video.elementum" optional="true"/>
    <import addon="plugin.video.torrest" optional="true"/>
    <!-- Resolución de enlaces de hosters (repo de terceros) -->
    <import addon="script.module.resolveurl" optional="true"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="es_ES">Addon personal con menús de contenido</summary>
    <description lang="es_ES">Menú principal con Películas, Series, Deportes, Televisión, Cocina y Varios. Soporta HLS, DASH, RTMP, listas M3U, DRM Widevine, torrents (vía Elementum/Torrest) y YouTube (vídeos, listas, canales y búsquedas) y enlaces plugin://. El contenido se define en resources/lib/menus.py</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
