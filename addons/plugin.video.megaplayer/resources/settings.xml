<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
  <category label="Cuentas MEGA">
    <setting label="Gestionar cuentas MEGA (añadir, editar, eliminar)" type="action" action="RunPlugin(plugin://plugin.video.megaplayer/?a=accounts)"/>
    <setting id="port" type="number" label="Puerto local del servidor (reiniciar Kodi si cambia)" default="48765"/>
  </category>
  <category label="Torrents">
    <setting id="torrent_engine" type="enum" label="Motor de torrents" values="Elementum|Torrest" default="0"/>
  </category>
  <category label="Biblioteca">
    <setting id="export_path" type="folder" label="Carpeta destino de los .strm" option="writeable" default=""/>
    <setting id="thumbs" type="bool" label="Usar las propias fotos como miniatura" default="true"/>
  </category>
</settings>
