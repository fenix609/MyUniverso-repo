{
  "id": "vidzi",
  "name": "Vidzi",

  "active": true,
  "notes": "Alternative vía: Script.Module.ResolveUrl",

  "find_videos": {
    "ignore_urls": [],
    "patterns": [
      {
        "pattern": "vidzi.tv/(?:embed-|embed/|)([a-z0-9A-Z]+)",
        "url": "https://vidzi.org/embed-\\1"
      },
      {
        "pattern": "vidzi.org/(?:embed-|embed/|)([a-z0-9A-Z]+)",
        "url": "https://vidzi.org/embed-\\1"
      },
      {
        "pattern": "vidzi.cc/(?:embed-|embed/|)([a-z0-9A-Z]+)",
        "url": "https://vidzi.org/embed-\\1"
      }
    ]
  }

}